import { randInt, sleep } from '../utils.ts';
import { SIZE } from '../config.ts';

const tab: boolean[][] = [...Array(SIZE)].map(() => Array(SIZE).fill(false));

const container = document.getElementsByClassName('render')[0];
createGrid(tab);
const grid: HTMLDivElement = document.getElementsByClassName('render')[0]
	.firstChild as HTMLDivElement;

exploreGrid(tab);

function createGrid(tab: boolean[][], cellSize: number = 10) {
	const canvas = document.createElement('canvas');
	canvas.width = SIZE * cellSize;
	canvas.height = SIZE * cellSize;
	canvas.style.border = '1px solid #909090';
	container.innerHTML = '';
	container.appendChild(canvas);

	const ctx = canvas.getContext('2d')!;
	for (let x = 0; x < SIZE; x++) {
		for (let y = 0; y < SIZE; y++) {
			ctx.fillStyle = tab[x][y] ? 'black' : 'white';
			ctx.fillRect(y * cellSize, x * cellSize, cellSize, cellSize);
			ctx.strokeStyle = '#909090';
			ctx.strokeRect(y * cellSize, x * cellSize, cellSize, cellSize);
		}
	}
}

function renderGrid(cell: [number, number], cellSize: number = 10) {
	const canvas = container.querySelector('canvas') as HTMLCanvasElement;
	const ctx = canvas.getContext('2d')!;
	ctx.fillStyle = 'black';
	ctx.fillRect(cell[1] * cellSize, cell[0] * cellSize, cellSize, cellSize);
	ctx.strokeStyle = '#909090';
	ctx.strokeRect(cell[1] * cellSize, cell[0] * cellSize, cellSize, cellSize);
}

async function exploreGrid(
	tab: boolean[][],
	startX: number = randInt(),
	startY: number = randInt()
) {
	const queue: [number, number][] = [[startX, startY]];

	const directions = [
		[0, 1],
		[0, -1],
		[1, 0],
		[-1, 0],
	];
	renderGrid(queue[0]);

	while (queue.length > 0) {
		const [x, y] = queue.shift()!;
		if (tab[x][y]) continue;
		// Découverte
		tab[x][y] = true;

		// Recherche
		research(tab, x, y, directions, queue);

		// Affichage
		renderGrid([x, y]);
		sleep();
	}
	console.log('Finished');
}

function research(
	tab: boolean[][],
	x: number,
	y: number,
	directions: number[][],
	queue: [number, number][]
) {
	console.log('Recherche');
	for (const [dx, dy] of directions) {
		const nx = x + dx;
		const ny = y + dy;
		if (nx >= 0 && nx < SIZE && ny >= 0 && ny < SIZE && !tab[nx][ny]) {
			const np: [number, number] = [nx, ny];
			queue.splice(0, 0, np);
		}
	}
}
